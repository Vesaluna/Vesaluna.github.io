extends partial/layout

block site_title
    != page.title + " · " + config.title

block description
    meta(name="description", content=page_description(page))

block content
    .autopagerize_page_element
        .content.media-page
            h1.media-page-title= page.title
            if page.content
                .media-page-intro!= page.content
            - var items = media_items(page);
            - var years = [...new Set(items.map(function (item) { return item.periodKey === 'undated' ? 'undated' : item.periodKey.slice(0, 4); }))];
            if years.length
                .media-years(role="group", aria-label=__('Year'))
                    button.media-year.is-active(type="button", data-media-year="all", aria-pressed="true")= __('All')
                    each year in years
                        button.media-year(type="button", data-media-year=year, aria-pressed="false")= year === 'undated' ? __('Undated') : year
            .media-filters(role="group", aria-label=page.title)
                button.media-filter.is-active(type="button", data-media-filter="all", aria-pressed="true")= __('All')
                button.media-filter(type="button", data-media-filter="book", aria-pressed="false")= __('Books')
                button.media-filter(type="button", data-media-filter="game", aria-pressed="false")= __('Games')
                button.media-filter(type="button", data-media-filter="movie", aria-pressed="false")= __('Movies')
            if items.length
                - var periodGroups = [];
                - var periodGroupByKey = {};
                - items.forEach(function (item) {
                -   if (!periodGroupByKey[item.periodKey]) {
                -     periodGroupByKey[item.periodKey] = { key: item.periodKey, label: item.periodLabel, items: [] };
                -     periodGroups.push(periodGroupByKey[item.periodKey]);
                -   }
                -   periodGroupByKey[item.periodKey].items.push(item);
                - });
                each period in periodGroups
                    section.media-period(data-media-group=period.key, data-media-year=period.key === 'undated' ? 'undated' : period.key.slice(0, 4))
                        h2.media-period-title= period.label
                        .media-grid
                            each item in period.items
                                button.media-card(type="button", data-media-type=item.type, data-media-id=item.id, aria-label=__('OpenReview', item.title))
                                    if item.cover
                                        img.media-cover(src=item.cover, alt=item.title, width="320", height="480", loading="lazy", decoding="async")
                                    else
                                        span.media-cover-placeholder= item.title
                                    span.media-card-title= item.title
                p.media-filter-empty(hidden)= __('NoMediaForFilter')
                dialog#media-dialog.media-dialog(
                    aria-labelledby="media-dialog-title",
                    data-label-original-title=__('OriginalTitle'),
                    data-label-creator=__('Creator'),
                    data-label-year=__('Year'),
                    data-label-finished-on=__('FinishedOn'),
                    data-label-steam-playtime=__('SteamPlaytime'),
                    data-label-last-played-on=__('LastPlayedOn'),
                    data-label-steam-acquired-on=__('SteamAcquiredOn'),
                    data-label-completed-count=__('CompletedCount'),
                    data-label-tags=__('Tags'),
                    data-label-chinese-only=__('ChineseOnly'),
                    data-label-review-pending=__('ReviewPending'),
                    data-label-related-article=__('RelatedArticle'),
                    data-label-more-info=__('MoreInfo')
                )
                    .media-dialog-inner
                        button.media-dialog-close(type="button", aria-label=__('Close')) ×
                        .media-dialog-layout
                            img.media-dialog-cover(src="", alt="", width="320", height="480", decoding="async", hidden)
                            .media-dialog-copy
                                h2#media-dialog-title
                                .media-dialog-body
                script#media-library-data(type="application/json")!= JSON.stringify(items).replace(/</g, '\\u003c')
            else
                p.media-empty= __('EmptyMedia')
