doctype
- var documentLang = (page.lang || config.language || 'zh-cn').toString().toLowerCase();
- if (documentLang === 'zh-cn') documentLang = 'zh-CN';
html(lang=documentLang)
    head
        include head

    body
        div#stage.container
            div.row
                include sidebar
                div#main-container.col-sm-9.col-xs-12.main-container

                    block content
                    div.visible-xs.site-bottom-footer
                        include footer


        script(src= url_for('js/typography.js'), defer)
        if page.path == "index.html"
            script(src= url_for('js/home-quotes.js'), defer)
        if page.layout == "media"
            script(src= url_for('js/media-library.js'), defer)
        if page.layout == "search"
            script(src= url_for('js/search.js'), defer)
