mixin make_post(item, is_detail, is_page)
    div.post-container
        if is_detail
            h1.post-title= item.title
        else
            p.post-title
                a(href= url_for(item.path))= item.title
        if !is_page
            p.post-meta
                span.date.meta-item!=__("posted_at")+"&nbsp;" + date(item.date, 'YYYY-MM-DD')
                if theme.duoshuo || theme.disqus
                    span.meta-item
                        i.fa.fa-comment-o
                        span &nbsp;
                        a(href= url_for(item.path + "#comments"))= __('Comments')
                if theme.showCategories
                    if item.categories
                        if item.categories.length > 0
                            span.meta-item
                                i.fa.fa-folder
                                span &nbsp;
                                - item.categories.sort('posts').each(function(item) {
                                a.a-tag(href=config.root + item.path, title= item.name)= item.name
                                span &nbsp;
                                - });
                if theme.showTags
                    if item.tags
                        if item.tags.length > 0
                            span.meta-item
                                i.fa.fa-tag
                                span &nbsp;
                                - item.tags.sort('posts').each(function(item) {
                                a.a-tag(href=config.root + item.path, title= item.name)= item.name
                                span &nbsp;
                                - });
        if is_detail && item.ai_translation
            - var sourceVersion = language_switches(item).find(function (language) { return language.code === 'zh-cn' && language.available; });
            p.translation-notice
                span.translation-notice-badge AI
                span= __('AITranslationNotice')
                if sourceVersion
                    span.translation-notice-separator ·
                    a(href=sourceVersion.url, hreflang="zh-cn")= __('SourceVersion')
        if is_detail
            div.post-abstract!= item.content
        else
            p.post-abstract!= truncate(strip_html(item.content.replace(/<mjx-container\b[^>]*>[\s\S]*?<\/mjx-container>/gi, ' ').replace(/<pre(?: |>)[^]*?<\/pre>/gm, ' ')).replace(/\s+/g, ' ').trim(), {length: 100})

mixin make_page_links()
    if site.pages
        - site.pages.sort('nav_order').each(function (page) {
            li
                    if is_current(page.path)
                        a.current(href=config.root+page.path)= page.title
                    else
                        a(href=config.root+page.path)= page.title
        - });


mixin make_pager()
    - var prev = page.prev_link
    - var next = page.next_link
    nav.pagination.no-margin-bottom(aria-label="Pagination")
        div.clearfix
            if theme.showPageCount
                p
                    != ' ' + __('PageNumber', page.current) + ' / ' + __('PageCount', page.total) + ' '
                    | &nbsp;
            if page.prev || page.next
                p
                    if page.prev
                        span.pre.pagbuttons
                            span.pager-arrow(aria-hidden="true") «
                            | &nbsp;
                            a(href=url_for(prev), aria-label=__('prev'))= __('prev')
                    if page.prev && page.next
                        span &nbsp;
                    if page.next
                        span.next.pagbuttons
                            a(href=url_for(next), aria-label=__('next'))= __('next')
                            | &nbsp;
                            span.pager-arrow(aria-hidden="true") »

mixin postList()
    - var year = 0;
    - var change = false;
    - var firstYear = true;
    - var fixupRequired = page.posts.length > 0;
    - page.posts.each(function (item) {
    - var itemYear = date(item.date, 'YYYY') - 0;
    - change = year !== itemYear;
    - year = change ? itemYear : year;
    if change
        if firstYear
            | <li class="listing-title">
            h4.ar-year!= year
            | <ul class="listing">
            - firstYear = false;
        else
            | </ul></li><li class="listing-title">
            h4.ar-year!= year
            | <ul class="listing">

    | <li class="listing-item">
    .listing-post
        p.post-title
            a(href= url_for(item.path), title= item.title)= item.title
        div.post-time
            span.ar-date= date(item.date, 'MM-DD')
    | </li>
    - })
    if fixupRequired
        | </ul></li>

mixin tagList()
    ul.listing
        - site.tags.each(function (item) {    
        | <li class="listing-item">
        .listing-post
            p.post-title
                a(href= url_for(item.path), title= item.name)= item.name
            span.date.meta-item
                != __('TagCount', item.posts.length)
        | </li>
        - })

mixin categoryList()
    ul.listing
        - site.categories.each(function (item) {    
        | <li class="listing-item">
        .listing-post
            p.post-title
                a(href= url_for(item.path), title= item.name)= item.name
            span.date.meta-item
                != __('CategoriesCount', item.posts.length)
        | </li>
        - })
