extends partial/layout

include mixins

block site_title
    != page.title + " · " + config.title

block description
    meta(name="description", content=page_description(page))

block content
    .autopagerize_page_element: .content: .post-page
        include mixins
        +make_post(page, true)
        - var prev = page.prev ? page.prev.path : false;
        - var next = page.next ? page.next.path : false;
        nav.pagination(aria-label="Post navigation")
            div.clearfix
                if prev
                    span.pre.pagbuttons
                        a(href=url_for(prev), title=page.prev.title)
                            i.fa.fa-angle-double-left(aria-hidden="true")
                            |&nbsp;
                            != __('prev_post')+': ' + page.prev.title
                if prev && next
                    span &nbsp;
                if next
                    span.next.pagbuttons
                        a(href=url_for(next), title=page.next.title)
                            != __('next_post')+': ' + page.next.title
                            |&nbsp;
                            i.fa.fa-angle-double-right(aria-hidden="true")
        include partial/comments
